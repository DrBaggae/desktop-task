{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desktop-task",
  "version": "0.1.0",
  "identifier": "com.drbaggage.desktop-task",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
  "title": "desktop-task",
  "width": 280,
  "height": 170,
  "decorations": false,
  "transparent": true,
  "alwaysOnTop": false,
  "resizable": false,
  "label": "widget"
},
      {
  "title": "Task Manager",
  "width": 800,
  "height": 600,
  "decorations": true,
  "transparent": false,
  "resizable": true,
  "label": "main",
  "visible": false,
  "url": "http://localhost:1420"
}
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}